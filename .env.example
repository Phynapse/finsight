# ---------------------------------------------------------------------------
# FinSight - example environment file
#
# Copy to `.env` for local development:      cp .env.example .env
# Never commit a populated `.env`.
# Every value below has a safe default in `backend/app/core/config.py`, so the
# application boots with no .env file at all.
# ---------------------------------------------------------------------------

# --- Application -----------------------------------------------------------
APP_NAME=FinSight
APP_ENV=development
APP_VERSION=0.1.0
DEBUG=false

# --- Logging ---------------------------------------------------------------
LOG_LEVEL=INFO
# true -> JSON lines (for log shippers); false -> human readable console
LOG_JSON=false

# --- Data ------------------------------------------------------------------
# Directory containing the bundled CSV datasets. Resolved relative to the
# repository root when set to a relative path. Only files registered in the
# dataset catalog are ever read; arbitrary paths from clients are rejected.
DATA_DIR=data

# --- HTTP ------------------------------------------------------------------
API_PREFIX=/api/v1
# Comma separated list. Only these origins may call the API from a browser.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Hard ceiling on request body size in bytes (default 16 KiB).
MAX_REQUEST_BYTES=16384
# Hard ceiling on the user question length in characters.
MAX_QUESTION_LENGTH=500
MAX_DIMENSIONS=3
MAX_LIMIT=25
REQUEST_TIMEOUT_SECONDS=30

# --- In-memory analysis store ---------------------------------------------
ANALYSIS_STORE_MAX_ITEMS=100
ANALYSIS_STORE_TTL_SECONDS=3600

# --- LLM provider (Phase 2) ------------------------------------------------
# The LLM is optional. FinSight runs fully without it: all financial numbers
# are computed deterministically in Python/Pandas regardless of this setting.
# provider: disabled | openai | anthropic | ollama
LLM_PROVIDER=disabled
LLM_MODEL=
LLM_API_KEY=
LLM_BASE_URL=
LLM_TIMEOUT_SECONDS=20
LLM_MAX_TOKENS=1200